# MeDa Partners OS — Frontend Environment Configuration
# ==============================================================================
# Configure the real base URL of the Express backend API.
# The frontend connects directly to this endpoint using fetch with credentials: 'include'.
#
# Examples:
# Local Development: http://localhost:5000/api/v1
# Staging/Production: https://api.medapartners.com/api/v1
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
