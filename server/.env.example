# ==================================================
# MeDa Partners OS - Server Environment Configuration
# ==================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Connection String
# Use either direct connection (port 5432) or transaction pooler (port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meda_os

# Client CORS Origin
CORS_ORIGIN=http://localhost:3000

# Server-Side Session Security
SESSION_COOKIE_NAME=meda_session
SESSION_TTL_HOURS=168

# Initial System Administrator (Used during database seeding)
ADMIN_INITIAL_EMAIL=admin@meda.com
ADMIN_INITIAL_PASSWORD=Admin@MeDa2026!
ADMIN_INITIAL_NAME=System Administrator
